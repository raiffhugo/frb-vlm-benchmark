# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Regenerated at runtime (~60 GB when fully rebuilt); only the metadata
# manifests referenced in the paper are tracked.
dataset/*
!dataset/metadata/
dataset/metadata/*
!dataset/metadata/labels.jsonl
!dataset/metadata/labels.csv
!dataset/metadata/image_manifest.jsonl
!dataset/metadata/burst_visibility_sim.csv
dataset_binary/*
!dataset_binary/metadata/
dataset_binary/metadata/*
!dataset_binary/metadata/labels.jsonl
!dataset_binary/metadata/labels.csv
!dataset_binary/metadata/image_manifest.jsonl
results/
logs/

# Real FAST-FREX data. The PSRFITS files are 244-488 MB each (~412 GB for the
# full set) and are downloaded from ScienceDB by fetch_fast_frex.py; only the
# manifests, the visibility diagnostic and the file index are tracked.
fast_frex/*
!fast_frex/*.csv
!fast_frex/scidb_index.json

# Images rendered by prepare-real (~800 MB). Only the manifest that documents
# the preprocessing of every sample is tracked, plus the three spectra shown in
# the article figure.
dataset_real_full/*
!dataset_real_full/metadata/
dataset_real_full/metadata/*
!dataset_real_full/metadata/image_manifest.jsonl
!dataset_real_full/images/
dataset_real_full/images/*
!dataset_real_full/images/samples/
dataset_real_full/images/samples/*
!dataset_real_full/images/samples/sample_000320.png
!dataset_real_full/images/samples/sample_000477.png
!dataset_real_full/images/samples/sample_000616.png

# Revision v4 (release v1.2). The images and FITS files of the new runs are
# regenerated by revision_v4/; only the manifests that the per-sample predictions in
# results_v4/ record in their provenance (same SHA-256) are tracked.
dataset_e1/*
!dataset_e1/metadata/
dataset_e1/metadata/*
!dataset_e1/metadata/labels.jsonl
!dataset_e1/metadata/labels.csv
!dataset_e1/metadata/image_manifest.jsonl
dataset_e1_binary/*
!dataset_e1_binary/metadata/
dataset_e1_binary/metadata/*
!dataset_e1_binary/metadata/labels.jsonl
!dataset_e1_binary/metadata/labels.csv
!dataset_e1_binary/metadata/image_manifest.jsonl
dataset_real_e2/*
!dataset_real_e2/metadata/
dataset_real_e2/metadata/*
!dataset_real_e2/metadata/image_manifest.jsonl
dataset_real_e3/*
!dataset_real_e3/metadata/
dataset_real_e3/metadata/*
!dataset_real_e3/metadata/image_manifest.jsonl
dataset_real_e4_p0/*
!dataset_real_e4_p0/metadata/
dataset_real_e4_p0/metadata/*
!dataset_real_e4_p0/metadata/image_manifest.jsonl
dataset_real_e4_p1/*
!dataset_real_e4_p1/metadata/
dataset_real_e4_p1/metadata/*
!dataset_real_e4_p1/metadata/image_manifest.jsonl
dataset_real_e4_p2/*
!dataset_real_e4_p2/metadata/
dataset_real_e4_p2/metadata/*
!dataset_real_e4_p2/metadata/image_manifest.jsonl
dataset_e8_decimated/*
!dataset_e8_decimated/metadata/
dataset_e8_decimated/metadata/*
!dataset_e8_decimated/metadata/image_manifest.jsonl
# Console logs of the v4 runs (progress bars); the provenance is in the JSON manifests.
results_v4/**/*.log
# Rating interface assembled by revision_v4/labeling_tool.py (it holds the anonymized images).
labeling_v4/

# SimulateSearch temporary outputs
*.dat
*.sf
*.fits.tmp

# Local/editor files
.env
.env.*
.DS_Store
.idea/
.vscode/
.claude/
CLAUDE.md
AGENTS.md
